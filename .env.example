# No cloud TTS key is required. Kokoro runs locally.
TTS_API_KEY=your_private_api_key_for_api_clients_here

# Optional: override the Python executable used to run Kokoro.
# By default the server automatically uses .kokoro-venv.
# Windows:
# PYTHON_COMMAND=.kokoro-venv\\Scripts\\python.exe
# macOS/Linux:
# PYTHON_COMMAND=.kokoro-venv/bin/python

# Keep this only if you want the existing scanned-PDF Gemini OCR fallback.
GEMINI_API_KEY=your_gemini_api_key_here

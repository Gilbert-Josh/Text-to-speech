{
  "name": "text-to-speech-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "main": "electron/main.cjs",
  "description": "Local desktop text-to-speech studio powered by Kokoro.",
  "build": {
    "appId": "com.gilbertjosh.texttospeechstudio",
    "productName": "Text to Speech Studio",
    "artifactName": "Text-to-Speech-Studio-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!local-tts/**/*",
      "!src/**/*",
      "!scripts/**/*",
      "!packaging/**/*",
      "!API.md",
      "!.env.example",
      "!server.ts",
      "!vite.config.ts",
      "!tsconfig.json"
    ],
    "extraResources": [
      {
        "from": "packaging/runtime/kokoro_tts.exe",
        "to": "kokoro-runtime/kokoro_tts.exe"
      },
      {
        "from": "packaging/runtime/model",
        "to": "kokoro-runtime/model"
      },
      {
        "from": "packaging/runtime/espeak-ng",
        "to": "kokoro-runtime/espeak-ng"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Text-to-Speech-Studio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Text to Speech Studio",
      "artifactName": "Text-to-Speech-Studio-Setup.${ext}"
    }
  }
}
